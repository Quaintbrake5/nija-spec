{
  "name": "nija-audit",
  "version": "1.0.0",
  "description": "Nigeria-first Compliance-as-Code architectural auditing engine",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node bin/nija.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "check": "ts-node bin/nija.ts check",
    "generate": "ts-node bin/nija.ts generate",
    "init": "ts-node bin/nija.ts init",
    "verify": "ts-node bin/nija.ts verify",
    "estimate": "ts-node bin/nija.ts estimate",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "compliance",
    "nigeria",
    "ndpa",
    "cbn",
    "audit"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "bin": {
    "nija-audit": "dist/bin/nija.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0"
  }
}
